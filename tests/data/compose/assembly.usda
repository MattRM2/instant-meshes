#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 0.01
    subLayers = [
        @./assembly_extra.usda@
    ]
    upAxis = "Y"
)

def Xform "World"
{
    def Xform "propA" (
        prepend references = @./prop.usda@
    )
    {
        double3 xformOp:translate = (-4, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:rotateY", "xformOp:translate"]
    }

    def Xform "propB" (
        prepend references = @./prop.usda@</Prop>
        variants = {
            string size = "big"
        }
    )
    {
        double3 xformOp:translate = (0, 0, 4)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        over "geo"
        {
            over "render"
            {
                over "Box"
                {
                    color3f[] primvars:displayColor = [(1, 0, 0)]
                }
            }
        }
    }

    def Xform "propC" (
        prepend payload = @./prop.usdc@
    )
    {
        double3 xformOp:translate = (4, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Xform "inst" (
        instanceable = true
        prepend references = @./prop.usda@
    )
    {
        double3 xformOp:translate = (0, 0, -4)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Xform "off" (
        active = false
        prepend references = @./prop.usda@
    )
    {
    }

    def Xform "tree" (
        prepend inherits = </_tree>
    )
    {
        double3 xformOp:translate = (-4, 0, -4)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Xform "rock" (
        prepend specializes = </_rock>
    )
    {
        double3 xformOp:translate = (4, 0, -4)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Xform "treeCopy" (
        prepend references = </World/tree>
    )
    {
        double3 xformOp:translate:copy = (-2, 0, -2)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:translate:copy"]
    }
}

